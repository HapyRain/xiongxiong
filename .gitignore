# Godot 4+
.godot/
/android/

# 本地产物 / 临时
*.tmp
*.log
__pycache__/
*.pyc
.DS_Store
Thumbs.db

# 本机环境交接（不入库，勿推送）
docs/ENVIRONMENT.md

# UI 迭代副本与设计稿（不入库）—— 但 other/.gdignore 必须入库，
# 否则副本里的 class_name 会劫持 Godot 全局类缓存
other/*
!other/.gdignore
docs/xiongxiong_ui_redesign_plan.md

# agent 工具本地目录
.commandcode/

# 调试签名与本地密钥（勿上传）
*.keystore
*.jks
*.idsig
# per-machine Godot engine path override for tools/run_checks.ps1
tools/godot_path.local
